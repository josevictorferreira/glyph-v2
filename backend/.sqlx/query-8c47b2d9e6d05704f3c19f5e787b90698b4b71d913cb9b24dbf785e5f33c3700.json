  "query": "UPDATE jobs SET locked_at = now(), locked_by = $2\n         WHERE id = (\n           SELECT id FROM jobs\n           WHERE queue = $1 AND finished_at IS NULL AND locked_at IS NULL AND run_at <= now()\n           ORDER BY run_at, id\n           FOR UPDATE SKIP LOCKED\n           LIMIT 1\n         )\n         RETURNING id, kind, payload",
