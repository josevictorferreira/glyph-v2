# Backend address is substituted at container start from GLYPH_BACKEND_URL;
# only defined env vars are replaced, so nginx's own $uri/$host survive.

# gRPC location (below): native gRPC requests (envoy-translated gRPC-Web) go
# upstream as gRPC-Web and come back labelled as native gRPC; gRPC-Web
# requests keep their content types both ways.
map $http_content_type $grpc_upstream_content_type {
    ~^application/grpc-web  $http_content_type;
    ~^application/grpc      application/grpc-web+proto;
    default                 $http_content_type;
}
map $http_content_type $grpc_downstream_content_type {
    ~^application/grpc-web  $upstream_http_content_type;
    ~^application/grpc      application/grpc;
    default                 $upstream_http_content_type;
}

server {
    listen 8080;
    # Lets the Cilium ingress's envoy reach nginx over h2 should a client
    # negotiate it (envoy speaks the downstream protocol upstream); today its
    # listener offers no h2 ALPN, so traffic arrives as HTTP/1.1.
    http2 on;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Workflow imports travel as gRPC-Web POST bodies; the default 1m is too
    # small. Streaming responses must not be buffered or compressed (see the
    # gRPC-Web location below).
    client_max_body_size 25m;

    # Content-Security-Policy (spec 0022): served on every document the
    # frontend answers itself — `location /` (static files and the SPA
    # fallback) and `location = /index.html` (the fallback target). It must
    # NOT be set at server level: nginx inherits server-level add_header into
    # the proxied locations, and the backend's artifact preview carries its
    # own stricter `default-src 'none'` policy that must reach the browser
    # unoverridden. worker-src blob: is for Monaco's workers;
    # style-src 'unsafe-inline' for component style attributes.
    # Keep the two copies below identical.

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_vary on;

    # Vite emits content-hashed filenames here: cache forever, and a miss is a
    # real 404 (never index.html).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # gRPC-Web (Connect) and gRPC health. The Cilium ingress runs envoy's
    # grpc_web filter, which translates browser gRPC-Web into native gRPC
    # before it reaches nginx, over HTTP/1.1 (its listener offers no h2 ALPN).
    # Native gRPC carries grpc-status in HTTP trailers, and envoy drops
    # HTTP/1.1 trailers, so every successful call reached the browser with no
    # status ("missing trailer"). Instead, re-label native gRPC requests as
    # gRPC-Web and proxy over HTTP/1.1: tonic-web then writes the status as an
    # in-body trailer frame, and the response is labelled application/grpc so
    # envoy passes the body (trailer frame included) through untouched.
    # Requests that are already gRPC-Web pass through as is.
    # accept-encoding identity: compressed frames break gRPC-Web decoders.
    # No effective read timeout: server streaming would stall.
    location ~ ^/(glyph\.v1\.|grpc\.) {
        proxy_pass ${GLYPH_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Content-Type $grpc_upstream_content_type;
        proxy_set_header accept-encoding identity;
        proxy_hide_header Content-Type;
        add_header Content-Type $grpc_downstream_content_type always;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Step-run artifacts: zip download / preview can be long transfers.
    location ~ ^/workflows/[^/]+/runs/[^/]+/step_runs/[^/]+/(download|preview)$ {
        proxy_pass ${GLYPH_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /schemas/ {
        proxy_pass ${GLYPH_BACKEND_URL};
        proxy_set_header Host $host;
    }

    location = /up {
        proxy_pass ${GLYPH_BACKEND_URL};
    }

    # index.html is the SPA entry point: always revalidate.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    }

    # SPA routing: unknown paths fall back to index.html (internal redirect,
    # so deep links keep working). This location also serves root-level
    # static assets (theme-init.js), so it carries the document CSP.
    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
