# Frontend image: a separate microservice. Builds with frontend/ as context:
#   podman build --platform=linux/amd64 --file Containerfile .
# Generated code (src/gen, routeTree.gen.ts) is committed, so no buf/protoc
# step. Manifests are copied first so the dependency install layer is cached
# independently of src edits.
# ---- Build stage ----
FROM docker.io/library/node:22-bookworm-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

# ---- Runtime stage ----
# nginx serving the SPA and reverse-proxying API paths to the backend, mirroring
# the Vite dev proxy (vite.config.ts): gRPC-Web must pass through uncompressed
# and without a read timeout or frames buffer and live updates stall. The
# unprivileged variant runs as the nginx user and listens on 8080.
FROM docker.io/nginxinc/nginx-unprivileged:1.28-bookworm AS runtime

COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

# Resolved into the nginx config at container start (envsubst on templates).
# Default targets the backend service in the apps namespace.
ENV GLYPH_BACKEND_URL=http://glyph.apps.svc.cluster.local:3000

EXPOSE 8080
