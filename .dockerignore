# Context for backend/Containerfile, which builds with the repository root as
# context (build.rs compiles ../proto). The frontend is its own microservice
# with its own image and context (frontend/.dockerignore).

# Nix / build artifacts
/result
/result-*
/backend/target

# Local state and secrets
.dev
.env
.env*.local

# VCS and agent tooling
.git
.gitignore
.agents
.omc
.omo

# Root node workspace is not part of the backend image
node_modules
package.json
pnpm-lock.yaml

# Not needed to build the backend image; backend/tests is never COPYed and its
# fixtures are only include_str!'d under #[cfg(test)].
frontend
backend/tests
*.md
